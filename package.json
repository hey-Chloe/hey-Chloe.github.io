{
  "name": "li-chenyue-homepage",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/finalize-export.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "check:browser": "node scripts/browser-check.mjs",
    "figures:optimize": "node scripts/optimize-research-thumbnails.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:links",
    "audit:lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "gray-matter": "4.0.3",
    "katex": "0.16.47",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "7.0.1",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "server-only": "0.0.1",
    "shiki": "3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "chrome-launcher": "1.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "lighthouse": "12.8.2",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
